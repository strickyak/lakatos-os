package main

// clear3: Inside-out expanding rectangle from center (1 second).

func checkCancel() bool {
	if os_serial_available() > 0 {
		ch := os_serial_read()
		if ch == 'q' || ch == 'Q' || ch == 3 {
			return true
		}
	}
	clicked, _, _ := os_read_click()
	return clicked != 0
}

func main() {
	for step := 1; step <= 40; step = step + 1 {
		if checkCancel() {
			os_exit(0)
		}
		w := step * 8
		h := step * 6
		x := 160 - w/2
		y := 120 - h/2
		os_tft_fill_rect(x, y, w, h, 0x0000)
		os_delay_ms(25)
	}
	os_tft_fill_screen(0x0000)
	os_exit(0)
}
