package main

// clear11: Two-phase 40x40 checkerboard (even squares first 0.5s, odd squares next 0.5s).

func checkCancel() bool {
	if os_serial_available() > 0 {
		ch := os_serial_read()
		if ch == 'q' || ch == 'Q' || ch == 3 {
			return true
		}
	}
	clicked, _, _ := os_read_click()
	return clicked != 0
}

func main() {
	for parity := 0; parity < 2; parity = parity + 1 {
		for r := 0; r < 6; r = r + 1 {
			for c := 0; c < 8; c = c + 1 {
				if (r+c)%2 == parity {
					if checkCancel() {
						os_exit(0)
					}
					os_tft_fill_rect(c*40, r*40, 40, 40, 0x0000)
					os_delay_ms(21)
				}
			}
		}
	}
	os_tft_fill_screen(0x0000)
	os_exit(0)
}
