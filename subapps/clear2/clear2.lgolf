package main

// clear2: Top-to-bottom horizontal curtain wipe (1 second).

func checkCancel() bool {
	if os_serial_available() > 0 {
		ch := os_serial_read()
		if ch == 'q' || ch == 'Q' || ch == 3 {
			return true
		}
	}
	clicked, _, _ := os_read_click()
	return clicked != 0
}

func main() {
	for step := 0; step < 40; step = step + 1 {
		if checkCancel() {
			os_exit(0)
		}
		os_tft_fill_rect(0, step*6, 320, 6, 0x0000)
		os_delay_ms(25)
	}
	os_tft_fill_screen(0x0000)
	os_exit(0)
}
