package main

// clear8: Clockwise radar fan sweep from center (1 second).

const CX = 160
const CY = 120
const R = 210.0

func checkCancel() bool {
	if os_serial_available() > 0 {
		ch := os_serial_read()
		if ch == 'q' || ch == 'Q' || ch == 3 {
			return true
		}
	}
	clicked, _, _ := os_read_click()
	return clicked != 0
}

func main() {
	for step := 0; step < 40; step = step + 1 {
		if checkCancel() {
			os_exit(0)
		}
		deg0 := -90.0 + float32(step)*9.0 - 0.5
		deg1 := -90.0 + float32(step+1)*9.0 + 0.5
		a0 := deg0 * DEG_TO_RAD
		a1 := deg1 * DEG_TO_RAD
		x0 := CX + int(round(cos(a0)*R))
		y0 := CY + int(round(sin(a0)*R))
		x1 := CX + int(round(cos(a1)*R))
		y1 := CY + int(round(sin(a1)*R))
		os_tft_fill_triangle(CX, CY, x0, y0, x1, y1, 0x0000)
		os_delay_ms(25)
	}
	os_tft_fill_screen(0x0000)
	os_exit(0)
}
